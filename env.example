# =============================================================================
# INICIO RÁPIDO
# =============================================================================
# 1. Copia este archivo a `.env` (cp env.example .env).
# 2. Para `docker compose` con el servicio `api`, define SECRET_KEY en `.env`
#    (el compose inyecta SECRET_KEY=${SECRET_KEY}; no hay fallback inseguro).
#    Generar clave fuerte: openssl rand -hex 32
# 3. GridBot API (autenticación propia de la app, distinta de Binance):
API_KEY=YOUR_GRIDBOT_API_KEY_HERE

# =============================================================================
# CONFIGURACIÓN DE LA BASE DE DATOS
# =============================================================================
DATABASE_URL=postgresql://griduser:gridpass@localhost:5432/gridbot
POSTGRES_USER=griduser
POSTGRES_PASSWORD=gridpass
POSTGRES_DB=gridbot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# CONFIGURACIÓN DE REDIS Y CELERY
# =============================================================================
REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# CONFIGURACIÓN DE BINANCE
# =============================================================================
BINANCE_API_KEY=YOUR_BINANCE_API_KEY_HERE
BINANCE_SECRET_KEY=YOUR_BINANCE_SECRET_KEY_HERE
BINANCE_TESTNET=false
BINANCE_API_URL=https://api.binance.com

# Proxy para tráfico a Binance (opcional).
# Desde Heroku EU la conexión directa funciona sin proxy ni 451.
# Solo necesario si tu hosting tiene IPs bloqueadas por Binance.
# Se acepta QUOTAGUARDSHIELD_URL (legacy) o BINANCE_PROXY_URL (genérico).
# Si ninguna está definida, el tráfico sale directo.
# BINANCE_PROXY_URL=
# QUOTAGUARDSHIELD_URL=

# =============================================================================
# CONFIGURACIÓN DE TELEGRAM
# =============================================================================
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# =============================================================================
# CONFIGURACIÓN DE SEGURIDAD
# =============================================================================
# SECRET_KEY: obligatorio para JWT/sesiones y para docker-compose (servicio api).
# Nunca commitees valores reales. Solo desarrollo (inseguro): cadena larga
# aleatoria local; producción: openssl rand -hex 32 o gestor de secretos.
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Lista blanca Host header (TrustedHostMiddleware). Debe incluir el dominio público
# si expones la API tras un proxy. En Docker siempre se añaden además: api, api_dev,
# gridbot_api, gridbot_api_dev (webhooks Alertmanager usan el nombre del servicio `api`).
# Ejemplo explícito:
# TRUSTED_HOSTS=localhost,127.0.0.1,testserver,mi-dominio.com

# =============================================================================
# CONFIGURACIÓN DE LA APLICACIÓN
# =============================================================================
DEBUG=true
ENVIRONMENT=development
DOCKER_ENV=false
LOG_LEVEL=INFO
API_V1_STR=/api/v1
PROJECT_NAME=GridBot Trading Platform
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# =============================================================================
# STACK LOCAL (docker-compose.local.yml) — solo si hay nombres/puertos tomados
# =============================================================================
# Permite levantar un segundo stack paper al lado de uno ya corriendo.
# GRIDBOT_PREFIX=gridbot
# API_PORT=8000
# DB_PORT=5432
# REDIS_PORT=6379
# FLOWER_PORT=5555
# PROMETHEUS_PORT=9090
# ALERTMANAGER_PORT=9093
# GRAFANA_PORT=3000

# =============================================================================
# CONFIGURACIÓN DE MONITOREO
# =============================================================================
PROMETHEUS_MULTIPROC_DIR=/tmp
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true

# URL pública de la app (usado para keep-alive anti cold-start en Heroku)
# Ejemplo: https://YOUR-APP-NAME.herokuapp.com
APP_URL=

# =============================================================================
# CONFIGURACIÓN DE TRADING
# =============================================================================
DEFAULT_GRID_LEVELS=10
MIN_NOTIONAL=10.0
MAX_ACTIVE_ORDERS=100
TRADING_ENABLED=true

# Modo de operación. El default de la plantilla es PAPER (simulación).
# PAPER_TRADING=true  → app/core/optimized_grid_manager y BinanceService simulan órdenes.
# PAPER_TRADING=false → la app intenta operar con Binance real si hay credenciales válidas.
# FORCE_REAL_MODE anula PAPER_TRADING; dejarlo vacío. Pasar a real exige el gate
# humano documentado en Docs/ops/paper-stack-evidence-2026-08.md.
PAPER_TRADING=true
FORCE_REAL_MODE=
EMERGENCY_STOP=false

# =============================================================================
# CONFIGURACIÓN DE RIESGO
# =============================================================================
MAX_DAILY_LOSS_PERCENT=5.0
MAX_POSITION_SIZE_PERCENT=20.0
STOP_LOSS_PERCENT=10.0
MAX_DRAWDOWN_PERCENT=15.0

# Capital risk engine (ADR-003 / RFC-002): drawdown vs capital aportado, no HWM
CONTRIBUTED_CAPITAL_USD=1000
KILL_DRAWDOWN_PCT=0.25
DAILY_LOSS_LIMIT_PCT=0.03
ALERT_DRAWDOWN_PCT=0.15
# Base del kill: trading (default, decisión CEO 2026-08-05) | pool
# trading = capital aportado - reserva de ops; aísla la pérdida de estrategia del
# gasto operativo. pool = lectura literal vs aportado, queda como alerta informativa.
KILL_BASIS=trading
# Techo de reserva de ops (Amendment 01: <= 100, devengo mensual ~10-15/mes).
# El devengado real lo administra el ops ledger (Track B); si no está disponible el
# engine asume este techo como comprometido y gastado, y lo marca en el status
# (ops.assumed=true, ops.assumption=ops_reserve_total_ceiling).
OPS_RESERVE_USD=100
OPS_SPENT_USD=
# Override de equity de trading para dashboards/paper mientras S6 no esté wired
CAPITAL_RISK_EQUITY_USD=
CAPITAL_RISK_EQUITY_PREV_EOD_USD=
CAPITAL_RISK_STATE_PATH=paper_trading_state.json

# =============================================================================
# CONFIGURACIÓN DE REBALANCEO V2 - LIQUIDEZ AUTÓNOMA
# =============================================================================
ENABLE_AUTO_REBALANCE=true
MIN_USDT_BALANCE=25.0
TARGET_USDT_BALANCE=50.0
REBALANCE_ASSET_PRIORITY=SPK,HOME,SIGN,BNB,BTC

# =============================================================================
# MULTI-VENUE — BrokerAdapter (protocolo Passive Income §8)
# =============================================================================
# Venue por defecto: Binance spot. ``byma`` / ``rofex`` resuelven a stub (sin I/O) hasta conectividad.
# BROKER_PRIMARY_VENUE=binance_spot
# Opt-in: órdenes MARKET desde TradeExecutor/Celery, POST /order y grid (solo SELL real) vía BrokerAdapter.
# Requiere BROKER_PRIMARY_VENUE=binance_spot (o omitido). LIMIT y kwargs extra siguen por cliente legacy.
# USE_BROKER_ADAPTER=false

# =============================================================================
# CONFIGURACIÓN DE MACHINE LEARNING
# =============================================================================
# Docker local instala requirements-ml.txt y puede activar HybridMLEngine con ML_ENABLED=true.
ML_ENABLED=false
ML_MODELS_DIR=data/ml/hybrid
MODEL_UPDATE_FREQUENCY=86400
PREDICTION_CONFIDENCE_THRESHOLD=0.7

# Gate de promoción ML (ciclo): TQS + Monte Carlo opcional + métricas after-cost de backtest.
# Por defecto desactivado (misma semántica que ML_PROMOTION_GATE_ENABLED ausente).
# ML_PROMOTION_GATE_ENABLED=false
# ML_PROMOTION_GATE_BLOCK_FLAT=true
# ML_PROMOTION_GATE_MIN_ABS_COMBINED=
# ML_PROMOTION_GATE_MAX_P95_DD=
# ML_PROMOTION_GATE_REQUIRE_MC=false
# ML_PROMOTION_GATE_MC_PATHS=256
# ML_PROMOTION_GATE_MC_HORIZON=20
# ML_PROMOTION_GATE_MC_SHOCK_SINGLE_MULT=
# ML_PROMOTION_GATE_MC_SHOCK_RUN3_MULT=
# ML_PROMOTION_GATE_MC_BOOTSTRAP=iid
# ML_PROMOTION_GATE_MC_BLOCK_SIZE=5
# Persistir cada estudio MC del gate en `monte_carlo_runs` (opt-in; puede crecer la tabla).
# ML_PROMOTION_GATE_PERSIST_MC=false
# Opcional: FK `monte_carlo_runs.backtest_run_id` hacia la última corrida leída del gate (BD).
# ML_PROMOTION_GATE_MC_ATTACH_BACKTEST_RUN_ID=true
# Retención por símbolo: tras persistir, borrar MC más antiguas que las N últimas (vacío = sin poda).
# ML_PROMOTION_GATE_MC_RETENTION_KEEP_LAST=
# Borrar corridas con created_at estrictamente anterior a hoy − N días (vacío = sin TTL; se aplica antes de KEEP_LAST).
# ML_PROMOTION_GATE_MC_RETENTION_MAX_AGE_DAYS=
# Última corrida `backtest_runs` (por símbolo, case-insensitive) y/o JSON de prueba:
# ML_PROMOTION_GATE_USE_PERSISTED_BACKTEST=false
# ML_PROMOTION_GATE_BACKTEST_SNAPSHOT_JSON=
# ML_PROMOTION_GATE_REQUIRE_BACKTEST=false
# ML_PROMOTION_GATE_MIN_SHARPE_AFTER_COST=
# ML_PROMOTION_GATE_MAX_BACKTEST_DD_MAGNITUDE=
# ML_PROMOTION_GATE_MIN_TOTAL_RETURN_AFTER_COST=
# ML_PROMOTION_GATE_MC_P95_VS_BACKTEST_DD_RATIO=

# Veto NLP opcional (sin tablas G3): score en Redis ``gridbot:tqs_sentiment:{SYMBOL}``
# como JSON {"score": 0.1} o número; rango recomendado [-1, 1]. Sin inferencia en el ciclo.
# ML_PROMOTION_GATE_NLP_ENABLED=false
# ML_PROMOTION_GATE_NLP_MIN_SCORE=-0.35
# ML_PROMOTION_GATE_NLP_BLOCK_IF_MISSING=false
# ML_PROMOTION_GATE_NLP_STUB_SCORE=

# Escala Kelly fraccional por sentimiento Redis (gridbot:tqs_sentiment:<SYMBOL>), opt-in
# KELLY_SENTIMENT_SCALE_ENABLED=false
# KELLY_SENTIMENT_MULT_AT_MINUS_ONE=0.65
# KELLY_SENTIMENT_MULT_AT_PLUS_ONE=1.10
# KELLY_SENTIMENT_MULT_IF_MISSING=1.0

# =============================================================================
# CONFIGURACIÓN DE BACKTESTING
# =============================================================================
BACKTEST_DATA_DAYS=30
BACKTEST_ENABLED=true

# =============================================================================
# CONFIGURACIÓN DE ALERTAS
# =============================================================================
ALERT_EMAIL_ENABLED=false
ALERT_SMS_ENABLED=false
ALERT_TELEGRAM_ENABLED=true

# =============================================================================
# CONFIGURACIÓN DE LOGS
# =============================================================================
LOG_FILE_PATH=./logs/gridbot.log
LOG_MAX_SIZE=1024MB
LOG_BACKUP_COUNT=5

# Producción / Papertrail (plan free 10 MB/día): mantener volumen bajo
# ENVIRONMENT=production  → consola solo WARNING+ (app/main.py y optimized_logging)
# LOG_LEVEL=WARNING       → recomendado en prod (por defecto si ENVIRONMENT=production)
# ACCESS_LOG=false        → no loguear cada request HTTP (opcional, ahorra muchas líneas)
# Volumen estimado con WARNING+ y ACCESS_LOG=false: ~0,5–2 MB/día (web + worker)

# =============================================================================
# CONFIGURACIÓN DE CACHE
# =============================================================================
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# =============================================================================
# CONFIGURACIÓN DE RATE LIMITING
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# CONFIGURACIÓN DE CORREO ELECTRÓNICO (OPCIONAL)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@gridbot.com

# =============================================================================
# CONFIGURACIÓN DE SLACK (OPCIONAL)
# =============================================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#gridbot-alerts

# =============================================================================
# CONFIGURACIÓN DE AWS S3 (OPCIONAL)
# =============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=gridbot-data

# =============================================================================
# CONFIGURACIÓN DE SENTRY (OPCIONAL)
# =============================================================================
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development

# =============================================================================
# CONFIGURACIÓN DE DIRECTORIOS DE ARTIFACTOS
# =============================================================================
MONITORING_DIR=monitoring_data
REPORTS_DIR=reports

# =============================================================================
# RESERVA DE OPS (ADR-008 / RFC-001, enmendado por CEO-01 2026-08-05)
# =============================================================================
# Ops al mínimo durante L0: la reserva prorrateada consumía 1,1-1,8% del capital
# tradable cada 21 días, del mismo orden que el PnL esperado del grid.
#
# OPS_RESERVE_USD es el TECHO de la reserva, no lo comprometido. Lo comprometido
# se devenga mes a mes (OPS_MONTHLY_CAP_USD) desde OPS_ACCRUAL_START, y es lo
# que el risk engine resta al capital aportado:
#   tradable_capital = contributed_capital - ops_reserve_committed
OPS_RESERVE_USD=100
OPS_MONTHLY_CAP_USD=15
OPS_ACCRUAL_START=2026-08-05
# Categorías con presupuesto cero. En L0: LLM pago excluido hasta que el Core
# demuestre PnL. Vaciar la variable para levantar la exclusión.
OPS_EXCLUDED_CATEGORIES=llm
OPS_LEDGER_PATH=data/ops_ledger.json

# =============================================================================
# PRODUCCIÓN HEROKU CON NEON + UPSTASH (tier gratis)
# =============================================================================
# Sustituir add-ons heroku-postgresql y heroku-redis por servicios externos.
# No commitear valores reales. Configurar en Heroku: heroku config:set ...
# Ver: Docs/MIGRATION_HEROKU_FREE_TIER.md
#
# DATABASE_URL=postgresql://user:pass@host.neon.tech/dbname?sslmode=require
# REDIS_URL=rediss://default:password@xxx.upstash.io:6379
# CELERY_BROKER_URL=<misma que REDIS_URL>
# CELERY_RESULT_BACKEND=<misma que REDIS_URL>
