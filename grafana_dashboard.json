{
  "dashboard": {
    "id": null,
    "title": "GridBot Dashboard",
    "tags": ["gridbot", "trading"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Estado del Sistema",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"gridbot-api\"}",
            "legendFormat": "API Status"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Uso de CPU",
        "type": "graph",
        "targets": [
          {
            "expr": "process_cpu_seconds_total{job=\"gridbot-api\"}",
            "legendFormat": "CPU Usage"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Uso de Memoria",
        "type": "graph",
        "targets": [
          {
            "expr": "process_resident_memory_bytes{job=\"gridbot-api\"}",
            "legendFormat": "Memory Usage"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Garbage Collection",
        "type": "graph",
        "targets": [
          {
            "expr": "python_gc_collections_total{job=\"gridbot-api\"}",
            "legendFormat": "GC Collections - Gen {{generation}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
} 