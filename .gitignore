# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Entorno virtual
.venv/
venv/
ENV/

# Archivos de entorno y configuración sensible
.env
.env.*
*.env
*.secret
*.keys
*.pem
*production.env

# Directorio de secretos (claves Ed25519 Binance, etc.)
secrets/

# Gates live firmados (ADR-007): artefacto de operación, no de código.
# Solo la plantilla no firmada se versiona.
Docs/gates/LIVE_GATE_*.md
Docs/gates/LIVE_GATE_*.json
!Docs/gates/LIVE_GATE_TEMPLATE.md

# Docker
*.log
docker-compose.override.yml

# Runtime logs y artefactos (no versionar). El directorio `logs/` se conserva
# en el repo solo con logs/.gitkeep (runtime escribe fuera de git).
logs/**
!logs/.gitkeep

# VSCode
.vscode/

# Otros
.DS_Store
.idea/
*.sqlite3

# Tests y resultados temporales
htmlcov/
.coverage
.cache/

# Jupyter
.ipynb_checkpoints/

# Artefactos de monitoreo y reportes
monitoring_data/**
!monitoring_data/.gitkeep
reports/**
!reports/.gitkeep

# Telemetría de equity paper (S10): ledger y serie MtM del proceso.
# Es estado contable de una ventana concreta, no configuración versionable.
paper_telemetry/**
!paper_telemetry/.gitkeep

# Artefactos JSON en raíz generados por scripts (migrados a reports/)
/*.json
!/grid_config_minimal.json
!/grid_config_optimized.json
!/grid_config_safe.json
!/grid_config_paper_l0.json
!/grid_config_paper_l0.hash
