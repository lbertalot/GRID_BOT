{
  "dashboard": {
    "id": null,
    "title": "GridBot Profit/Loss Dashboard",
    "tags": ["gridbot", "pnl", "trading", "profit"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "P&L Total (USDT)",
        "type": "stat",
        "targets": [
          {
            "expr": "gridbot_total_pnl_usdt",
            "legendFormat": "Total P&L"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": -1000},
                {"color": "yellow", "value": 0},
                {"color": "green", "value": 1000}
              ]
            },
            "custom": {
              "displayMode": "gradient-gauge"
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "P&L Porcentual (%)",
        "type": "stat",
        "targets": [
          {
            "expr": "gridbot_pnl_percentage",
            "legendFormat": "P&L %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": -10},
                {"color": "yellow", "value": 0},
                {"color": "green", "value": 10}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "Valor del Portfolio (USDT)",
        "type": "stat",
        "targets": [
          {
            "expr": "gridbot_portfolio_value_usdt",
            "legendFormat": "Portfolio Value"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "Estado de Trading",
        "type": "stat",
        "targets": [
          {
            "expr": "gridbot_trading_status",
            "legendFormat": "Status"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "green", "value": 2}
              ]
            },
            "mappings": [
              {
                "options": {
                  "0": {"text": "PERDIENDO", "color": "red"},
                  "1": {"text": "NEUTRAL", "color": "yellow"},
                  "2": {"text": "GANANDO", "color": "green"}
                },
                "type": "value"
              }
            ]
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}
      },
      {
        "id": 5,
        "title": "P&L por Estrategia (Últimas 24h)",
        "type": "graph",
        "targets": [
          {
            "expr": "increase(gridbot_strategy_pnl_total[24h])",
            "legendFormat": "{{strategy}} - {{symbol}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": -100},
                {"color": "yellow", "value": 0},
                {"color": "green", "value": 100}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}
      },
      {
        "id": 6,
        "title": "P&L por Asset",
        "type": "graph",
        "targets": [
          {
            "expr": "gridbot_asset_pnl_usdt",
            "legendFormat": "{{asset}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}
      },
      {
        "id": 7,
        "title": "Evolución del Portfolio (7 días)",
        "type": "graph",
        "targets": [
          {
            "expr": "gridbot_portfolio_value_usdt",
            "legendFormat": "Portfolio Value"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}
      },
      {
        "id": 8,
        "title": "P&L Diario",
        "type": "graph",
        "targets": [
          {
            "expr": "gridbot_daily_pnl_usdt",
            "legendFormat": "Daily P&L"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": -50},
                {"color": "yellow", "value": 0},
                {"color": "green", "value": 50}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}
      },
      {
        "id": 9,
        "title": "Órdenes Exitosas vs Fallidas",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum(gridbot_orders_total) by (status)",
            "legendFormat": "{{status}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20}
      },
      {
        "id": 10,
        "title": "Tasa de Éxito de Órdenes",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(gridbot_orders_total{status=\"success\"}) / sum(gridbot_orders_total) * 100",
            "legendFormat": "Success Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 80},
                {"color": "yellow", "value": 90},
                {"color": "green", "value": 95}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 20}
      },
      {
        "id": 11,
        "title": "Volumen de Trading (24h)",
        "type": "stat",
        "targets": [
          {
            "expr": "increase(gridbot_trading_volume_total[24h])",
            "legendFormat": "24h Volume"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD"
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 20}
      }
    ],
    "time": {
      "from": "now-7d",
      "to": "now"
    },
    "refresh": "30s",
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": "-- Grafana --",
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "editable": true,
    "gnetId": null,
    "graphTooltip": 0,
    "links": [],
    "liveNow": false,
    "schemaVersion": 30,
    "style": "dark",
    "templating": {
      "list": []
    },
    "timepicker": {},
    "timezone": "",
    "title": "GridBot Profit/Loss Dashboard",
    "uid": "gridbot-pnl",
    "version": 1
  }
} 