# ========================================
# GridBot Trading Platform - Configuración
# ========================================

# ========================================
# BINANCE API CONFIGURATION (OBLIGATORIO)
# ========================================
# Obtén tus API Keys en: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# ========================================
# TELEGRAM CONFIGURATION (OBLIGATORIO)
# ========================================
# Crea un bot con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ========================================
# TRADING CONFIGURATION
# ========================================
# Par de trading (ej: BTCUSDT, ETHUSDT)
TRADING_PAIR=BTCUSDT

# Niveles de grid (recomendado: 10-20)
GRID_LEVELS=10

# Precio mínimo y máximo para el grid
MIN_PRICE=45000
MAX_PRICE=55000

# Cantidad por operación (en la criptomoneda base)
QUANTITY_PER_TRADE=0.001

# Rebalanceo automático
AUTO_REBALANCE=true

# ========================================
# RISK MANAGEMENT
# ========================================
# Pérdida máxima diaria (%)
MAX_DAILY_LOSS=5.0

# Stop loss (%)
STOP_LOSS=10.0

# Tamaño máximo de posición (%)
MAX_POSITION_SIZE=20.0

# ========================================
# DATABASE CONFIGURATION
# ========================================
DATABASE_URL=postgresql://gridbot:gridbot123@db:5432/gridbot
REDIS_URL=redis://redis:6379/0

# ========================================
# CELERY CONFIGURATION
# ========================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ========================================
# APPLICATION SETTINGS
# ========================================
# Nombre del proyecto
PROJECT_NAME=GridBot Trading Platform

# Entorno (development, production)
ENVIRONMENT=development

# Debug mode
DEBUG=true

# CORS origins
CORS_ORIGINS=["*"]

# ========================================
# MONITORING
# ========================================
# Prometheus metrics
ENABLE_METRICS=true

# Grafana dashboard
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=gridbot123

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=INFO
LOG_FILE=logs/gridbot.log

# ========================================
# SECURITY
# ========================================
# JWT Secret (cambiar en producción)
JWT_SECRET_KEY=your_jwt_secret_key_here

# JWT Algorithm
JWT_ALGORITHM=HS256

# JWT Expiration (en minutos)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========================================
# OPTIONAL SETTINGS
# ========================================
# Email notifications (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# Slack notifications (opcional)
SLACK_WEBHOOK_URL=your_slack_webhook_url

# AWS S3 para backups (opcional)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your_s3_bucket_name

# Sentry para monitoreo de errores (opcional)
SENTRY_DSN=your_sentry_dsn

# ========================================
# ADVANCED SETTINGS
# ========================================
# Intervalo de ejecución del grid (en segundos)
GRID_EXECUTION_INTERVAL=60

# Tiempo de espera entre órdenes (en segundos)
ORDER_WAIT_TIME=5

# Máximo número de órdenes pendientes
MAX_PENDING_ORDERS=20

# Tamaño mínimo de orden
MIN_ORDER_SIZE=10

# Comisión de trading (%)
TRADING_FEE=0.1

# ========================================
# BACKTESTING (para desarrollo)
# ========================================
# Habilitar modo backtesting
ENABLE_BACKTESTING=false

# Fecha de inicio para backtesting
BACKTEST_START_DATE=2024-01-01

# Fecha de fin para backtesting
BACKTEST_END_DATE=2024-12-31

# ========================================
# MACHINE LEARNING (futuro)
# ========================================
# Habilitar ML para optimización
ENABLE_ML=false

# Modelo de ML a usar
ML_MODEL=random_forest

# ========================================
# ALERTS AND NOTIFICATIONS
# ========================================
# Alertas de ganancia (%)
PROFIT_ALERT_THRESHOLD=5.0

# Alertas de pérdida (%)
LOSS_ALERT_THRESHOLD=3.0

# Alertas de volumen
VOLUME_ALERT_THRESHOLD=1000

# ========================================
# CACHE SETTINGS
# ========================================
# Tiempo de cache para precios (en segundos)
PRICE_CACHE_TTL=30

# Tiempo de cache para balance (en segundos)
BALANCE_CACHE_TTL=60

# ========================================
# RATE LIMITING
# ========================================
# Límite de requests por minuto
RATE_LIMIT_PER_MINUTE=100

# Límite de requests por hora
RATE_LIMIT_PER_HOUR=1000

# ========================================
# EMAIL SETTINGS (para reportes)
# ========================================
# Enviar reportes por email
SEND_EMAIL_REPORTS=false

# Frecuencia de reportes (daily, weekly, monthly)
REPORT_FREQUENCY=daily

# ========================================
# SLACK SETTINGS (para notificaciones)
# ========================================
# Canal de Slack para notificaciones
SLACK_CHANNEL=#gridbot-alerts

# Username del bot en Slack
SLACK_USERNAME=GridBot

# ========================================
# AWS S3 SETTINGS (para backups)
# ========================================
# Región de AWS
AWS_REGION=us-east-1

# Frecuencia de backups (daily, weekly)
BACKUP_FREQUENCY=daily

# ========================================
# SENTRY SETTINGS (para monitoreo)
# ========================================
# Entorno de Sentry
SENTRY_ENVIRONMENT=development

# Nivel de logging para Sentry
SENTRY_LOG_LEVEL=ERROR 