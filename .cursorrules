name: GridBot v2.5 Cursor Rules
version: 1

# Purpose
# Provide high-signal, enforceable rules to keep the codebase safe, observable, and scalable.
# Tailored to GridBot v2.5 (FastAPI + Celery + Redis + PostgreSQL + Prometheus/Grafana) with strict trading defenses.

coding_style:
  language: python
  python_version: ">=3.11"
  principles:
    - functional_and_declarative
    - prefer_plain_functions_over_classes
    - async_for_all_IO
    - RORO_pattern
    - strict_type_hints_everywhere
    - early_returns_and_guard_clauses
    - avoid_else_when_possible
    - long_names_are_better_than_abbreviations
  formatting:
    - keep_multi_line_readability
    - wrap_long_lines
    - match_existing_style
  numeric_precision:
    - use_decimal_for_money_prices_quantities
  validation:
    - validate_inputs_with_pydantic_v2
    - enforce_exchange_filters_PRICE_FILTER_LOT_SIZE_MIN_NOTIONAL
    - check_balance_and_breakers_before_order
  errors:
    - raise_HTTPException_for_expected_errors
    - centralize_unexpected_errors_in_middleware
  routers:
    - file_structure: app/api/* exports `router`
    - prefer_response_model_schemas_from_app/schemas
    - keep_routes_thin_delegate_to_services

architecture:
  stack:
    - FastAPI API
    - Celery workers/beat
    - Redis broker/cache
    - PostgreSQL persistence
    - Prometheus/Grafana observability
  key_dirs:
    api: app/api/
    services: app/services/
    core: app/core/
    models: app/models/
    schemas: app/schemas/
    scheduler: app/scheduler/
  rules:
    - critical_logic_lives_in_services
    - do_not_block_in_routes
    - use_fastapi_dependencies_for_shared_state
    - instrument_every_critical_path_with_metrics
    - interact_with_circuit_breakers_for_critical_ops

observability:
  prometheus:
    http_middleware: app/core/middleware/prometheus_http.py
    metrics_module: app/core/metrics.py
    must_do:
      - increment `gridbot_api_requests_total` and `api_request_duration_seconds` via middleware/utilities
      - export `/metrics` via app/api/prometheus.py
      - add counters/gauges/histograms for new features
    naming:
      - prefix_gridbot_for_key_metics
      - low_cardinality_labels_only
  logging:
    - structured_JSON_logs_preferred
    - include_trace_or_order_id_when_possible
  dashboards:
    - keep Grafana dashboards under docker/grafana/dashboards
    - update Docs/08-metrics-catalog.md when adding metrics

trading_defense:
  pre_order_validation:
    - validate against exchange_info: PRICE_FILTER, LOT_SIZE, MIN_NOTIONAL
    - enforce quantity and price rounding (stepSize, tickSize)
    - reject if notional below min_notional
    - check available balance
  idempotency:
    - use `client_order_id` for exchange interactions
  breakers:
    - consult app/core/circuit_breakers.CircuitBreakers before risky ops
    - expose/track breaker state via app/core/metrics.py (gauge `breaker_state` and `active_breakers_total`)
  reconciliation:
    - keep reconciliation <= 60s cadence
    - instrument `reconciliation_latency_seconds` and discrepancy metrics

performance:
  async_everywhere:
    - async def for DB, Redis, Binance, HTTP
  latency_targets:
    - p99_api_latency_ms <= 250
  offload:
    - send heavy/long tasks to Celery workers

data_models:
  - use Pydantic v2 for request/response schemas
  - annotate all exported functions
  - avoid `any`; keep strict types

project_commands:
  dev:
    - docker compose --profile development up -d db redis
    - docker compose --profile development up -d api_dev
  prod_local:
    - docker compose --profile production up -d db redis prometheus grafana api
  uvicorn_local:
    - uvicorn app.main:app --reload --port 8000
  celery:
    - docker compose up -d celery_worker celery_beat
  tests:
    - python -m pip install -r requirements.txt
    - pytest -q
    - pytest --cov=app --cov-report=term-missing

secrets_and_env:
  never_commit:
    - real API keys
    - .env files
  critical_vars:
    - BINANCE_API_KEY
    - BINANCE_SECRET_KEY
    - PAPER_TRADING
    - FORCE_REAL_MODE
    - TRADING_ENABLED
    - EMERGENCY_STOP
    - DATABASE_URL
    - REDIS_URL

api_conventions:
  routes:
    - define in app/api/* and export `router`
    - use response_model and clear return annotations
    - protect sensitive routes with `require_auth`
  middleware:
    - PrometheusHTTPMiddleware for request metrics
    - IntegrityGuardMiddleware for safety
  health:
    - keep GET /health simple and fast

celery:
  app_module: app/core/celery_app.py
  queues:
    - default, low as configured in code
  schedules:
    - trading-cycle-tick: 60s
    - risk-assessment: 300s
    - performance-analysis: daily midnight
    - dust-sweep-weekly: Sundays 03:00 UTC (low queue, dry-run by default)

testing:
  principles:
    - coverage >= 85% for critical modules
    - isolate Binance via doubles/fixtures; prefer PAPER_TRADING/TESTNET
  run:
    - pytest -q
    - pytest --cov=app --cov-report=term-missing

PR_and_commits:
  conventional_commits:
    - feat|fix|docs|refactor|test|chore
  PR_checklist:
    - tests pass and coverage ok
    - no secrets in code/logs
    - validations and Decimal in critical calcs
    - Prometheus metrics updated and dashboards reviewed
    - docs updated (Docs/, AGENTS.md)
    - consider breaker/idempotency/rollback on critical ops

file_naming:
  - lowercase_snake_case for files and dirs
  - descriptive function names, no cryptic abbreviations

when_editing_code:
  MUST:
    - use Decimal for monetary math
    - add Prometheus metrics for new flows
    - add guard clauses at function start for validations
    - respect LOT_SIZE, PRICE_FILTER, MIN_NOTIONAL
    - check circuit breakers before placing orders
    - keep routes thin and defer to services
  SHOULD:
    - add unit tests for new logic
    - update Docs/08-metrics-catalog.md and Docs/09-endpoints-map.md

cursor_specific:
  session_size_vs_inline_diff:
    message: Cursor may suppress inline diffs when a single agent turn touches too many edits (IDE performance/UI cap; not a repo bug).
    agent_should:
      - batch work into smaller iterations (scoped module/feature per turn when scope is large)
      - avoid one-shot mega-diffs spanning code plus large docs migrations and many tests unless user explicitly asks
      - rely on Source Control sidebar for file-by-file review when inline chat diffs are suppressed
    user_fallback:
      - review diffs in Source Control view
      - optional smaller commits or branch/stash splits for review sanity; never commit .env or secrets
  search_first:
    - use ripgrep-based search (Grep tool) broadly, then narrow
  editing:
    - prefer small, focused edits; do not reformat unrelated code
  code_blocks:
    - when showing existing code, use code reference blocks with start:end:filepath format
    - for new code examples, use standard fenced blocks with language

scale_next_level_focus:
  - ensure idempotency across Celery tasks (at-least-once semantics)
  - strengthen ML fallback paths (hybrid/static rules on failures)
  - tighten cardinality on metrics labels
  - enforce low-latency API path and offload CPU-bound work
  - add regression tests for validation and reconciliation
  - document operational runbooks in Docs/operations and keep up-to-date
