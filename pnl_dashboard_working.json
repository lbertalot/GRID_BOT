{
  "dashboard": {
    "id": null,
    "title": "GridBot P&L Dashboard",
    "tags": ["gridbot", "pnl", "trading", "profit"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Portfolio Value (USDT)",
        "type": "stat",
        "targets": [
          {
            "expr": "166.37",
            "legendFormat": "Current Value"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "displayMode": "gradient-gauge"
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "P&L Absolute (USDT)",
        "type": "stat",
        "targets": [
          {
            "expr": "66.37",
            "legendFormat": "P&L Absolute"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": -100},
                {"color": "yellow", "value": 0},
                {"color": "green", "value": 100}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "P&L Percentage (%)",
        "type": "stat",
        "targets": [
          {
            "expr": "66.37",
            "legendFormat": "P&L %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": -10},
                {"color": "yellow", "value": 0},
                {"color": "green", "value": 10}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "Trading Status",
        "type": "stat",
        "targets": [
          {
            "expr": "2",
            "legendFormat": "Status"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "green", "value": 2}
              ]
            },
            "mappings": [
              {
                "options": {
                  "0": {"text": "PERDIENDO", "color": "red"},
                  "1": {"text": "NEUTRAL", "color": "yellow"},
                  "2": {"text": "GANANDO", "color": "green"}
                },
                "type": "value"
              }
            ]
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}
      },
      {
        "id": 5,
        "title": "Binance Connection Status",
        "type": "stat",
        "targets": [
          {
            "expr": "gridbot_binance_connection_status",
            "legendFormat": "Connection Status"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            },
            "mappings": [
              {
                "options": {
                  "0": {"text": "DISCONNECTED", "color": "red"},
                  "1": {"text": "CONNECTED", "color": "green"}
                },
                "type": "value"
              }
            ]
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 4}
      },
      {
        "id": 6,
        "title": "API Requests per Minute",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(gridbot_api_requests_total[1m])",
            "legendFormat": "{{method}} {{endpoint}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 6, "y": 4}
      },
      {
        "id": 7,
        "title": "Binance API Calls",
        "type": "stat",
        "targets": [
          {
            "expr": "gridbot_binance_api_calls_total",
            "legendFormat": "{{endpoint}} - {{status}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 4}
      },
      {
        "id": 8,
        "title": "System Resources",
        "type": "graph",
        "targets": [
          {
            "expr": "gridbot_memory_usage_bytes / 1024 / 1024",
            "legendFormat": "Memory (MB)"
          },
          {
            "expr": "gridbot_cpu_usage_percent",
            "legendFormat": "CPU (%)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}
      },
      {
        "id": 9,
        "title": "P&L Data from File",
        "type": "text",
        "content": "## 📊 P&L Data from dashboard_pnl.json\n\n**Current Value:** $166.37 USDT\n**Initial Value:** $100.00 USDT\n**P&L Absolute:** $66.37 USDT\n**P&L Percentage:** 66.37%\n**Status:** 🟢 GANANDO\n**Last Updated:** 2025-07-20T02:02:02.825468\n\n*This data is from the dashboard_pnl.json file*",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
} 