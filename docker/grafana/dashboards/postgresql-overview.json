{
  "id": null,
  "title": "PostgreSQL Overview - GridBot",
  "tags": ["postgresql", "database", "gridbot"],
  "style": "dark",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Database Connections",
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "datasource": "PostgreSQL",
          "rawQuery": true,
          "rawSql": "SELECT count(*) as connections FROM pg_stat_activity WHERE state = 'active'",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "displayMode": "basic"
          },
          "mappings": [],
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Database Size",
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "datasource": "PostgreSQL",
          "rawQuery": true,
          "rawSql": "SELECT pg_size_pretty(pg_database_size('gridbot')) as size",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "displayMode": "basic"
          },
          "mappings": [],
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "Active Queries",
      "type": "table",
      "targets": [
        {
          "refId": "A",
          "datasource": "PostgreSQL",
          "rawQuery": true,
          "rawSql": "SELECT pid, usename, application_name, client_addr, state, query_start, query FROM pg_stat_activity WHERE state = 'active' AND query NOT LIKE '%pg_stat_activity%' ORDER BY query_start DESC LIMIT 10",
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 4,
      "title": "Table Sizes",
      "type": "barchart",
      "targets": [
        {
          "refId": "A",
          "datasource": "PostgreSQL",
          "rawQuery": true,
          "rawSql": "SELECT schemaname, tablename, pg_size_pretty(pg_total_relation_size(schemaname||'.'||tablename)) as size FROM pg_tables WHERE schemaname = 'public' ORDER BY pg_total_relation_size(schemaname||'.'||tablename) DESC LIMIT 10",
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 5,
      "title": "Database Performance",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "datasource": "PostgreSQL",
          "rawQuery": true,
          "rawSql": "SELECT now() as time, xact_commit as commits, xact_rollback as rollbacks FROM pg_stat_database WHERE datname = 'gridbot'",
          "format": "time_series"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "id": 6,
      "title": "GridBot Trading Data",
      "type": "table",
      "targets": [
        {
          "refId": "A",
          "datasource": "PostgreSQL",
          "rawQuery": true,
          "rawSql": "SELECT 'trades' as table_name, count(*) as record_count FROM trades UNION ALL SELECT 'asset_limits' as table_name, count(*) as record_count FROM asset_limits UNION ALL SELECT 'grid_config' as table_name, count(*) as record_count FROM grid_config",
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      }
    },
    {
      "id": 7,
      "title": "Recent Trades",
      "type": "table",
      "targets": [
        {
          "refId": "A",
          "datasource": "PostgreSQL",
          "rawQuery": true,
          "rawSql": "SELECT symbol, side, quantity, price, executed_at FROM trades ORDER BY executed_at DESC LIMIT 20",
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    }
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
