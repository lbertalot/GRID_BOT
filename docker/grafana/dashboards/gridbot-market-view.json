      "title": "Mis Trades (ledger paper · 50)",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH executions AS (\n  SELECT\n    opened_at AS executed_at,\n    symbol,\n    'BUY' AS side,\n    buy_price AS price,\n    buy_quantity AS quantity,\n    buy_price * buy_quantity AS total_usdt,\n    NULL::numeric AS pnl_usdt\n  FROM paper_ledger_cycles\n  UNION ALL\n  SELECT\n    f.executed_at,\n    c.symbol,\n    f.side,\n    f.price,\n    f.quantity,\n    f.price * f.quantity AS total_usdt,\n    CASE WHEN f.side = 'SELL'\n      THEN (f.price - c.buy_price) * f.quantity\n      ELSE NULL::numeric END AS pnl_usdt\n  FROM paper_ledger_fills f\n  JOIN paper_ledger_cycles c ON c.cycle_id = f.cycle_id\n)\nSELECT\n  executed_at,\n  side,\n  price,\n  quantity,\n  total_usdt,\n  pnl_usdt\nFROM executions\nWHERE upper(symbol) = upper('$symbol')\n  AND $__timeFilter(executed_at)\nORDER BY executed_at DESC\nLIMIT 50;",
          "refId": "A"
        }
      ]
    },
