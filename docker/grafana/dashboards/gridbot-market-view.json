        "target": {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  timestamp AS \"time\",\n  '▲ BUY @ ' || trim(to_char(entry_price, 'FM999999990.00'))\n    || ' · qty ' || trim(to_char(quantity, 'FM999990.0000')) AS text,\n  'BUY' AS tags\nFROM trades\nWHERE $__timeFilter(timestamp)\n  AND upper(symbol) = upper('$symbol')\n  AND upper(side) = 'BUY'\nORDER BY 1;",
          "refId": "AnnoBuy"
        }
      },
      {
        "datasource": { "type": "postgres", "uid": "postgres" },
        "enable": true,
        "hide": false,
        "iconColor": "#cf304a",
        "name": "Bot SELL",
        "target": {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  timestamp AS \"time\",\n  '▼ SELL @ ' || trim(to_char(COALESCE(exit_price, entry_price), 'FM999999990.00'))\n    || ' · qty ' || trim(to_char(quantity, 'FM999990.0000')) AS text,\n  'SELL' AS tags\nFROM trades\nWHERE $__timeFilter(timestamp)\n  AND upper(symbol) = upper('$symbol')\n  AND (\n    upper(side) = 'SELL'\n    OR (upper(side) = 'BUY' AND exit_price IS NOT NULL)\n  )\nORDER BY 1;",
          "refId": "AnnoSell"
        }
      }
    ]
