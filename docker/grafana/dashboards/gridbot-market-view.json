      "title": "Cambio 24h %",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (\n  SELECT close_price::double precision AS px, open_time\n  FROM klines_data\n  WHERE upper(symbol) = upper('$symbol') AND interval = '$candle'\n  ORDER BY open_time DESC\n  LIMIT 1\n),\nref AS (\n  SELECT k.close_price::double precision AS px\n  FROM klines_data k, latest l\n  WHERE upper(k.symbol) = upper('$symbol')\n    AND k.interval = '$candle'\n    AND k.open_time <= l.open_time - interval '24 hours'\n  ORDER BY k.open_time DESC\n  LIMIT 1\n)\nSELECT\n  CASE WHEN ref.px IS NULL OR ref.px = 0 THEN NULL\n       ELSE ((latest.px / ref.px) - 1.0) * 100.0 END AS change_24h_pct\nFROM latest LEFT JOIN ref ON TRUE;",
          "refId": "A"
        }
      ]
    },
