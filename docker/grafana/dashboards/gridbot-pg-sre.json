      "id": 5,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  round(mean_exec_time::numeric, 2) AS mean_ms,\n  round(total_exec_time::numeric, 1) AS total_ms,\n  calls,\n  left(query, 120) AS query_trunc\nFROM pg_stat_statements\nWHERE dbid = (SELECT oid FROM pg_database WHERE datname = current_database())\n  AND query ~* '^\\s*(SELECT|INSERT|UPDATE|DELETE|WITH)\\b'\n  AND query !~* '^\\s*(SHOW|SET|BEGIN|COMMIT|ROLLBACK|DISCARD|GRANT|REVOKE|ALTER|CREATE|DROP|COMMENT|TRUNCATE|VACUUM|ANALYZE|REINDEX|CLUSTER|COPY|SECURITY)\\b'\n  AND query NOT ILIKE '%pg_catalog%'\n  AND query NOT ILIKE '%information_schema%'\n  AND query NOT ILIKE '%pg_stat_%'\n  AND query NOT ILIKE '%pg_settings%'\n  AND query NOT ILIKE '%pg_locks%'\n  AND query NOT ILIKE '%pg_class%'\n  AND query NOT ILIKE '%pg_namespace%'\n  AND query NOT ILIKE '%pg_database%'\n  AND query NOT ILIKE '%pg_extension%'\n  AND query NOT ILIKE '%pg_size_pretty%'\n  AND query NOT ILIKE '%pg_total_relation_size%'\n  AND query NOT ILIKE '%pg_table_size%'\n  AND query NOT ILIKE '%pg_indexes_size%'\n  AND query NOT ILIKE '%pg_ls_waldir%'\n  AND query NOT ILIKE '%pg_ls_tmpdir%'\n  AND query NOT ILIKE '%pg_ls_logdir%'\n  AND query NOT ILIKE '%schemaname%'\n  AND query NOT ILIKE '%current_database()%'\n  AND query NOT ILIKE '%autovacuum%'\nORDER BY mean_exec_time DESC\nLIMIT 5",
          "refId": "A"
        }
      ],
      "title": "Top 5 slow queries",
      "type": "table"
    },
