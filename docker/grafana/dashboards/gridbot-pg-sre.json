        "uid": "postgres"
      },
      "description": "Top 5 negocio (INSERT/UPDATE/SELECT app). Excluye pg_catalog, SHOW, Grafana y postgres_exporter. Warn >50ms · crit >200ms.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
