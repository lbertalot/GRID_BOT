      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "count (1h)"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "right"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "transparent",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.colorBackgroundApplyFromField",
                "value": "type"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "type"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "pattern": ".*failed.*",
                      "result": {
                        "color": "red",
                        "index": 0
                      }
                    },
                    "type": "regex"
                  },
                  {
                    "options": {
                      "pattern": ".*succeeded.*",
                      "result": {
                        "color": "green",
                        "index": 1
                      }
                    },
                    "type": "regex"
                  },
                  {
                    "options": {
                      "pattern": ".*retried.*",
                      "result": {
                        "color": "yellow",
                        "index": 2
                      }
                    },
                    "type": "regex"
                  }
                ]
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "transparent",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
